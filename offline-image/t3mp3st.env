T3MP3ST_HOST=127.0.0.1
T3MP3ST_PORT=3333
T3MP3ST_STATE_DIR=/var/lib/t3mp3st/state
HOME=/var/lib/t3mp3st/home
NODE_ENV=production
TEMPEST_DEFAULT_PROVIDER=codex
TEMPEST_LOCAL_BASE_URL=http://127.0.0.1:11434/api
TEMPEST_LOCAL_MODEL=qwen2.5-coder:1.5b
TEMPEST_LOCAL_TIMEOUT=600000
T3MP3ST_LLM_CONCURRENCY=1
