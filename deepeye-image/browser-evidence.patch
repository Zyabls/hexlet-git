diff --git a/tests/test_smart_browser_tester.py b/tests/test_smart_browser_tester.py
new file mode 100644
--- /dev/null
+++ b/tests/test_smart_browser_tester.py
@@ -0,0 +1,59 @@
+import asyncio
+
+from modules.browser_automation.smart_tester import SmartBrowserTester
+
+
+class _Dialog:
+    def __init__(self):
+        self.dismissed = False
+
+    async def dismiss(self):
+        self.dismissed = True
+
+
+class _Page:
+    def __init__(self, trigger_dialog):
+        self.handlers = {}
+        self.trigger_dialog = trigger_dialog
+        self.handler_registered_before_navigation = False
+
+    def on(self, event, handler):
+        self.handlers[event] = handler
+
+    def remove_listener(self, event, handler):
+        assert self.handlers[event] is handler
+        del self.handlers[event]
+
+    async def goto(self, *_args, **_kwargs):
+        self.handler_registered_before_navigation = "dialog" in self.handlers
+        if self.trigger_dialog:
+            await self.handlers["dialog"](_Dialog())
+
+
+def _run_xss_test(trigger_dialog):
+    tester = SmartBrowserTester({"advanced": {"screenshot_enabled": False}})
+    page = _Page(trigger_dialog)
+    tester.page = page
+    findings = asyncio.run(
+        tester.test_xss_browser(
+            "http://127.0.0.1:18080/?q=seed",
+            ["<script>alert('XSS')</script>"],
+        )
+    )
+    return findings, page
+
+
+def test_xss_browser_registers_dialog_listener_before_navigation():
+    findings, page = _run_xss_test(trigger_dialog=True)
+
+    assert page.handler_registered_before_navigation
+    assert len(findings) == 1
+    assert findings[0]["type"] == "Cross-Site Scripting (XSS) - Browser Verified"
+    assert "dialog" in findings[0]["evidence"].lower()
+
+
+def test_xss_browser_does_not_treat_reflection_as_execution():
+    findings, page = _run_xss_test(trigger_dialog=False)
+
+    assert page.handler_registered_before_navigation
+    assert findings == []
