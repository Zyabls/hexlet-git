DEEPEYE_APP_ROOT=/opt/deepeye
DEEPEYE_CONFIG=/etc/deepeye/config.yaml
DEEPEYE_PYTHON=/opt/deepeye/venv/bin/python
DEEPEYE_STATE_DIR=/var/lib/deepeye/state
DEEPEYE_REPORTS_DIR=/var/lib/deepeye/reports
DEEPEYE_LOGS_DIR=/var/lib/deepeye/logs/jobs
DEEPEYE_ALLOW_PRIVATE_TARGETS=0
DEEPEYE_ALLOWED_HOSTS=
PYTHONUNBUFFERED=1
NO_COLOR=1
