[Unit]
Description=Deep Eye authenticated web control plane
After=network-online.target deepeye-llm-relay.service
Wants=network-online.target
Requires=deepeye-llm-relay.service

[Service]
Type=simple
User=deepeye
Group=deepeye
WorkingDirectory=/opt/deepeye
Environment=HOME=/var/lib/deepeye/home
Environment=PATH=/opt/deepeye/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/deepeye/deepeye.env
ExecStart=/opt/deepeye/venv/bin/python /usr/local/lib/deepeye/deepeye-web.py
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=yes
RestrictSUIDSGID=yes
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
