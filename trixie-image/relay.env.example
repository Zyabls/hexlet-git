# Copy to /etc/t3mp3st/relay.env and set the API key with mode 0640 root:t3mp3st.
GPT_OSS_UPSTREAM=https://llm.enplus.group/v1
GPT_OSS_MODEL=gpt-oss-120b
GPT_OSS_API_KEY=
# strict (default), custom-ca, or insecure-host. insecure-host is limited to the
# exact hostname in GPT_OSS_UPSTREAM; it never disables TLS globally.
GPT_OSS_TLS_MODE=strict
GPT_OSS_CA_FILE=/etc/t3mp3st/corporate-ca.pem
