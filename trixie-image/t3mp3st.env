NODE_ENV=production
HOST=127.0.0.1
PORT=3333
TEMPEST_DEFAULT_PROVIDER=openai
TEMPEST_ENFORCE_SERVER_LLM=1
OPENAI_BASE_URL=http://127.0.0.1:18080/v1
OPENAI_MODEL=gpt-oss-120b
# Non-secret sentinel required by the adapter; the loopback relay discards it
# and injects GPT_OSS_API_KEY from its root-owned EnvironmentFile.
OPENAI_API_KEY=relay-managed-local-only
TEMPEST_MODEL_FALLBACK=0
TEMPEST_LLM_TIMEOUT_MS=300000
T3MP3ST_TASK_TIMEOUT_MS=900000
T3MP3ST_GENERAL_TIMEOUT_MS=600000
TEMPEST_LLM_MAX_OUTPUT_TOKENS=4096
TEMPEST_LLM_TEMPERATURE=0
T3MP3ST_REPORTS_DIR=/var/lib/t3mp3st/reports
T3MP3ST_EVIDENCE_DIR=/var/lib/t3mp3st/evidence
